# VarshaMitra FastAPI Backend Configuration
# Copy this file to .env and adjust variables as needed for your environment.

# Service metadata
PROJECT_NAME="VarshaMitra API"
VERSION="0.1.0"
DESCRIPTION="Hyperlocal climate-risk intelligence and agricultural decision-support service for Maharashtra."

# Runtime environment (development | staging | production)
ENVIRONMENT="development"
DEBUG=false

# Networking
HOST="127.0.0.1"
PORT=8000

# CORS Allowed Origins (JSON array of strings)
# Note: Wildcard '*' is NOT permitted in production.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# API Versioning Prefix
API_V1_PREFIX="/api/v1"

# Logging Level (DEBUG | INFO | WARNING | ERROR | CRITICAL)
LOG_LEVEL="INFO"

# Optional official Agmarknet price access (Data.gov.in API key)
# DATA_GOV_IN_API_KEY="your_data_gov_in_api_key_here"

# -----------------------------------------------------------------------------
# Optional External Meteorological Provider Credentials
# -----------------------------------------------------------------------------

# India Meteorological Department (IMD) Gateway Access
# Obtain institutional API key from https://api.imd.gov.in/public/api_reference.html
# IMD_API_KEY="your_institutional_imd_token_here"
# IMD_API_BASE_URL="https://api.imd.gov.in"

# Copernicus Climate Data Store (CDS) Direct API Access
# Obtain personal API token from https://cds.climate.copernicus.eu/how-to-api
# CDSAPI_URL="https://cds.climate.copernicus.eu/api"
# CDSAPI_KEY="your_copernicus_cds_api_key_here"

# -----------------------------------------------------------------------------
# NuGen Intelligence LLM Explanation Layer (Phase 5)
# -----------------------------------------------------------------------------
# Optional server-side explanation provider (https://docs.nugen.in)
# NuGen is an explanation layer only and NEVER alters validated agronomic outputs.
# NUGEN_ENABLED=false
# NUGEN_API_KEY="your_nugen_api_key_here"
# NUGEN_BASE_URL="https://api.nugen.in"
# NUGEN_MODEL="Qwen/Qwen2.5-0.5B-Instruct"
# NUGEN_TIMEOUT_SECONDS=12.0
# NUGEN_MAX_RETRIES=2
# -----------------------------------------------------------------------------
# Risk Summary Aggregation & In-Memory Caching (Phase 6)
# -----------------------------------------------------------------------------
# In-memory TTL cache duration for regional bulk risk evaluations (default: 900s = 15m)
RISK_SUMMARY_CACHE_TTL_SECONDS=900
# Maximum concurrent asynchronous block evaluations during bulk aggregation
RISK_SUMMARY_CONCURRENCY=8
